{
  "name": "me",
  "main": "./worker/router.ts",
  "compatibility_date": "2025-06-15",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    // `/apps/*` must hit the Worker first so release-pinned app modules are
    // served from R2 instead of the SPA `not_found_handling` fallback HTML.
    "run_worker_first": ["/_worker/*", "/blog", "/blog/*", "/sitemap.xml", "/apps/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
  },
  "r2_buckets": [
    {
      "binding": "BLOG",
      "bucket_name": "daopk-blog",
    },
    {
      "binding": "PHOTOS",
      "bucket_name": "daopk-photos",
    },
    {
      "binding": "FILES",
      "bucket_name": "daopk-files",
    },
    {
      "binding": "APPS",
      "bucket_name": "daopk-apps",
    },
  ],
}
