{
  "name": "me",
  "main": "./worker/router.ts",
  "compatibility_date": "2025-06-15",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": ["/blog", "/blog/*", "/sitemap.xml"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
  },
  "r2_buckets": [
    {
      "binding": "BLOG",
      "bucket_name": "daopk-blog",
    },
  ],
}
