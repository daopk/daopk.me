{
  "name": "me",
  "main": "./worker/router.ts",
  "compatibility_date": "2025-06-15",
  "keep_vars": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    // SEO and sitemap paths hit the Worker first so crawler requests can be
    // proxied to the internal API while normal browsers keep the SPA fallback.
    "run_worker_first": [
      "/blog",
      "/blog/*",
      "/sitemap.xml",
      "/sitemap-media.xml",
      "/sitemap-media-*.xml",
      "/movie/*",
      "/tv/*",
      "/vi/movie/*",
      "/vi/tv/*",
    ],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
  },
}
