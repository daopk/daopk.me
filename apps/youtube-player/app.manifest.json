{
  "id": "youtube-player",
  "name": "YouTube Player",
  "icon": "YoutubePlayerAppIcon",
  "category": "media",
  "singleton": false,
  "defaultWindow": { "width": 960, "height": 540, "centered": true },
  "keywords": ["youtube", "video", "player", "media", "embed"],
