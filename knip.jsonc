{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreFiles": [
    // Generated and template surfaces are intentionally kept as source assets.
    "src/apps/_template/**",
    "src/types/vue-axe.d.ts",
    // Knip does not trace Vue SFC <style src> or Sass @use chains reliably.
    "apps/*/src/styles/**/*.scss",
  ],
  "workspaces": {
    ".": {
      // Host/runtime/tooling entrypoints.
      "entry": ["src/runtime/*.ts!", "scripts/*.mjs"],
      "project": [
        "src/**/*.{ts,vue}!",
        "worker/**/*.ts!",
        "vite/**/*.ts",
        "scripts/**/*.mjs",
        "tests/**/*.ts",
        "apps/_shared/**/*.ts",
      ],
    },
    "apps/*": {
      // App packages keep their own build/typecheck toolchain deps so each
      // package remains independently buildable. The actual plugin/base-config
      // imports live in shared files under apps/_shared and apps/tsconfig.base.json.
      "ignoreDependencies": ["@vitejs/plugin-vue", "@vue/tsconfig"],
      "project": ["src/**/*.{ts,vue}!", "../_shared/**/*.ts"],
    },
  },
}
